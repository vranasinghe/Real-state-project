# Browser-safe public Supabase configuration; never use the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Empty uses same-origin /api (proxied by Vite in development).
VITE_API_BASE_URL=
# Production demos require explicit opt-in. Development permits local demo accounts.
VITE_ENABLE_DEMO=false
